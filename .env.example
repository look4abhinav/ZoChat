# Copy this file to `.env` and fill in your values.

# Required: API key for the Groq cloud provider (serves qwen/qwen3.8-27b).
GROQ_API_KEY=

# Optional: OpenAI-compatible base URL for Groq.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Required for hosted Postgres (Neon). When unset, ZoChat falls back to the
# local SQLite file at src/zochat/data/ZoDB.db.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
