# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored and loaded automatically by zochat via python-dotenv.

# Required: API key for the Opencode Go provider (serves the default deepseek-v4-flash model).
OPENCODE_API_KEY=

# Optional: OpenAI-compatible base URL for Opencode Go. Leave commented to use
# the built-in fallback (https://opencode.ai/zen/go/v1).
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1